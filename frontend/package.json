{
  "name": "frontend",
  "main": "electron/main.mjs",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "npm run build && electron ./electron/main.mjs",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && ELECTRON_DEV_SERVER_URL=http://127.0.0.1:5173 electron ./electron/main.mjs\"",
    "electron:dev:attach": "ELECTRON_DEV_SERVER_URL=http://127.0.0.1:5173 electron ./electron/main.mjs",
    "electron:icon:mac": "bash ./scripts/generate-mac-icon.sh",
    "electron:dist": "npm run build && npm run electron:icon:mac && npx electron-builder --mac",
    "electron:dist:publish": "npm run build && npm run electron:icon:mac && npx electron-builder --mac --publish always",
    "electron:dist:mac": "npm run build && npm run electron:icon:mac && npx electron-builder --mac dmg zip",
    "electron:dist:win": "npm run build && npx electron-builder --win nsis",
    "electron:dist:linux": "npm run build && npx electron-builder --linux AppImage",
    "electron:dist:all:publish": "npm run build && npm run electron:icon:mac && npx electron-builder --mac dmg zip --win nsis --linux AppImage --publish always"
  },
  "build": {
    "appId": "com.mangashadow.clone",
    "productName": "Manga Shadow",
    "artifactName": "Manga-Shadow-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BrandonAlmeida",
        "repo": "manga-shadow-clone",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "electron-updater": "^6.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^37.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
